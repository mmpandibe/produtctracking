{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Npro": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npro.Security": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Npro.Security": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Npro": ""
  },
  "DataProtection": {
    "KeysPath": "D:/nPro/keys"
  },
  "Storage": {
    "Disk": {
      "Root": "D:/nPro/files"
    }
  },
  "Hosting": {
    "TrustForwardedHeaders": false,
    "HttpsRedirect": false
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "WritesPerMinute": 300
  },
  "Attendance": {
    "Provider": "sample",
    "LateAfter": "10:00"
  },
  "Productivity": {
    "Provider": "sample"
  },
  "Features": {
    "DemoSwitcher": false
  },
  "Seed": {
    "DemoPassword": ""
  },
  "Retention": {
    "Enabled": true,
    "LegalHold": false,
    "DeactivatedUserYears": 2,
    "TimeLogYears": 7,
    "AttendanceMonths": 13
  }
}
